// Easy Item Dump
// Original developer: Bud (bud-aj29)
// Successor developers: Jaydee Wetwork & Grok Build
// Inventory drop is separate from container dump. It uses button.drop_all.
// Hotbar stacks are ignored unless $include_hotbar is true.
{
  "namespace": "crafting",
  "ez_drop_image": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_drop",
    "size": [
      24,
      8
    ],
    "alpha": 1.0
  },
  "ez_drop_image_filtered": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_drop_filtered",
    "size": [
      24,
      8
    ],
    "alpha": 1.0
  },
  "ez_drop_button_panel": {
    "$pressed_button_name": "unset_button_name",
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      30,
      15
    ],
    "layer": 6,
    "controls": [
      {
        "stack_panel_1": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            -7.5,
            0
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": "$ez_length"
          },
          "factory": {
            "name": "ez_drop_button_panel_factory_1",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      },
      {
        "stack_panel_1_hotbar": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            -7.5,
            0
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": 9
          },
          "factory": {
            "name": "ez_drop_hotbar_stack_panel_1",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ],
          "ignored": "(not $include_hotbar)",
          "$item_location": "hotbar_items"
        }
      },
      {
        "stack_panel_2": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            7.5,
            0
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": "$ez_length"
          },
          "factory": {
            "name": "ez_drop_button_panel_factory_2",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      },
      {
        "stack_panel_2_hotbar": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            7.5,
            0
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": 9
          },
          "factory": {
            "name": "ez_drop_hotbar_stack_panel_2",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ],
          "ignored": "(not $include_hotbar)",
          "$item_location": "hotbar_items"
        }
      },
      {
        "button@common_buttons.light_glyph_button": {
          "$default_glyph_color": "$light_glyph_hover_color",
          "layer": -1
        }
      },
      {
        "cursor_drop_once": {
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.cursor_drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.cursor_drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#filter"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#filter=-1) or (#filter=0)))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ],
    "$ez_length|default": 27,
    "$include_hotbar|default": false
  },
  "ez_drop_factory": {
    "type": "panel",
    "size": [
      "100%",
      0
    ],
    "controls": [
      {
        "input_panel": {
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#item_id_aux=-1))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "ez_drop_factory_filtered": {
    "type": "panel",
    "size": [
      "100%",
      0
    ],
    "controls": [
      {
        "input_panel": {
          "ignored": "$touch",
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#filter"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux=#filter and not ((#filter=-1) or (#filter=0)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "input_panel_touch": {
          "ignored": "(not $touch)",
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.drop_all",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#filter"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux=#filter and not ((#filter=-1) or (#filter=0)))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "player_inventory": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "drop_inventory@crafting.ez_drop_button_panel": {
            "$item_location": "inventory_items",
            "$button_content": "crafting.ez_drop_image",
            "$factory_selection": "crafting.ez_drop_factory",
            "offset": [
              0,
              -30
            ],
            "$ez_length": 27
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "drop_inventory_filtered@crafting.ez_drop_button_panel": {
            "$item_location": "inventory_items",
            "$button_content": "crafting.ez_drop_image_filtered",
            "$factory_selection": "crafting.ez_drop_factory_filtered",
            "offset": [
              0,
              -15
            ],
            "$ez_length": 27,
            "$include_hotbar": true
          }
        }
      }
    ]
  }
}
