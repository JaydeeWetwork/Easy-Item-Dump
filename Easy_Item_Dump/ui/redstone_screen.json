// Easy Item Dump
// Original developer: Bud (bud-aj29)
// Successor developers: Jaydee Wetwork & Grok Build
// Hopper, dispenser, dropper, and the desktop crafter. Controls are chest.ez_dump_*.
{
  "namespace": "redstone",
  "redstone_panel_top_half": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest@chest.ez_dump_button_panel": {
            "$item_location": "container_items",
