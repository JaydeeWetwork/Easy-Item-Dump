// Easy Item Dump
// Original developer: Bud (bud-aj29)
// Successor developers: Jaydee Wetwork & Grok Build
// Desktop container buttons live here. Other container screens only hook them.
// Two stack panels split the icon into hit areas. Each half drives every slot.
// Hotbar stacks are ignored unless $include_hotbar is true.
{
  "namespace": "chest",
  "ez_dump_image_from_chest": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_chest",
    "size": [
      8,
      24
    ],
    "alpha": 1.0
  },
  "ez_dump_image_from_inventory": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_inventory",
    "size": [
      8,
      24
    ],
    "alpha": 1.0
  },
  "ez_dump_image_from_chest_filtered": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_chest_filtered",
    "size": [
      8,
      24
    ],
    "alpha": 1.0
  },
  "ez_dump_image_from_inventory_filtered": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_inventory_filtered",
    "size": [
      8,
      24
    ],
    "alpha": 1.0
  },
  "ez_dump_button_panel": {
    "$pressed_button_name": "unset_button_name",
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      15,
      30
    ],
    "layer": 6,
    "controls": [
      {
        "stack_panel_1": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            0,
            -7.5
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": "$ez_length"
          },
          "factory": {
            "name": "ez_dump_button_panel_factory_1",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      },
      {
        "stack_panel_1_hotbar": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            0,
            -7.5
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": 9
          },
          "factory": {
            "name": "ez_dump_hotbar_stack_panel_1",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ],
          "ignored": "(not $include_hotbar)",
          "$item_location": "hotbar_items"
        }
      },
      {
        "stack_panel_2": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            0,
            7.5
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": "$ez_length"
          },
          "factory": {
            "name": "ez_dump_button_panel_factory_2",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      },
      {
        "stack_panel_2_hotbar": {
          "type": "stack_panel",
          "size": [
            15,
            15
          ],
          "offset": [
            0,
            7.5
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": 9
          },
          "factory": {
            "name": "ez_dump_hotbar_stack_panel_2",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ],
          "ignored": "(not $include_hotbar)",
          "$item_location": "hotbar_items"
        }
      },
      {
        "button@common_buttons.light_glyph_button": {
          "$default_glyph_color": "$light_glyph_hover_color",
          "layer": -1
        }
      }
    ],
    "$ez_length|default": 54,
    "$include_hotbar|default": false
  },
  "ez_dump_factory": {
    "type": "panel",
    "size": [
      "100%",
      0
    ],
    "controls": [
      {
        "input_panel": {
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#item_id_aux=-1))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "ez_dump_factory_filtered": {
    "type": "panel",
    "size": [
      "100%",
      0
    ],
    "controls": [
      {
        "input_panel": {
          "ignored": "$touch",
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#filter"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux=#filter and not ((#filter=-1) or (#filter=0)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "input_panel_touch": {
          "ignored": "(not $touch)",
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#filter"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux=#filter and not ((#filter=-1) or (#filter=0)))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "input_panel_controller": {
          "ignored": "$touch",
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_name": "#inventory_selected_item",
              "binding_name_override": "#filter"
            },
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#item_id_aux=#filter and not ((#filter=-1) or (#filter=0)))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "small_chest_panel/root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest@chest.ez_dump_button_panel": {
            "$item_location": "container_items",
            "$button_content": "chest.ez_dump_image_from_chest",
            "$factory_selection": "chest.ez_dump_factory",
            "offset": [
              -15,
              0
            ],
            "$ez_length": 27
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_inventory@chest.ez_dump_button_panel": {
            "$item_location": "inventory_items",
            "$button_content": "chest.ez_dump_image_from_inventory",
            "$factory_selection": "chest.ez_dump_factory",
            "offset": [
              -30,
              0
            ],
            "$ez_length": 27
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest_filtered@chest.ez_dump_button_panel": {
            "$item_location": "container_items",
            "$button_content": "chest.ez_dump_image_from_chest_filtered",
            "$factory_selection": "chest.ez_dump_factory_filtered",
            "offset": [
              -15,
              30
            ],
            "$ez_length": 27
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_inventory_filtered@chest.ez_dump_button_panel": {
            "$item_location": "inventory_items",
            "$button_content": "chest.ez_dump_image_from_inventory_filtered",
            "$factory_selection": "chest.ez_dump_factory_filtered",
            "offset": [
              -30,
              30
            ],
            "$ez_length": 27,
            "$include_hotbar": true
          }
        }
      }
    ]
  },
  "large_chest_panel/root_panel": {
    "modifications": [
      {
