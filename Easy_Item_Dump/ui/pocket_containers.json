// Easy Item Dump
// Original developer: Bud (bud-aj29)
// Successor developers: Jaydee Wetwork & Grok Build
// Horizontal pocket buttons. Same-item filtering uses chest.ez_dump_factory_filtered.
// ez_dump_factory_inventory skips the hotbar (collection index 0 through 8).
// Filtered buttons place the held stack once, using chest.ez_dump_cursor_place_*.
// Pocket player deposits use the combined hotbar and inventory collection.
{
  "namespace": "pocket_containers",
  "ez_dump_image_from_chest": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_chest_pocket",
    "size": [
      24,
      8
    ],
    "alpha": 1.0
  },
  "ez_dump_image_from_inventory": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_inventory_pocket",
    "size": [
      24,
      8
    ],
    "alpha": 1.0
  },
  "ez_dump_image_from_chest_filtered": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_chest_pocket_filtered",
    "size": [
      24,
      8
    ],
    "alpha": 1.0
  },
  "ez_dump_image_from_inventory_filtered": {
    "type": "image",
    "layer": 1,
    "texture": "textures/ez_dump_from_inventory_pocket_filtered",
    "size": [
      24,
      8
    ],
    "alpha": 1.0
  },
  "ez_dump_button_panel": {
    "$pressed_button_name": "unset_button_name",
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [
      30,
      15
    ],
    "layer": 6,
    "controls": [
      {
        "cursor_deposit": {
          "type": "panel",
          "layer": 1,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            "100%",
            "100%"
          ],
          "ignored": "(not $deposit_cursor)",
          "controls": [
            {
              "empty_slots": {
                "type": "stack_panel",
                "layer": 4,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [
                  "100%",
                  "100%"
                ],
                "collection_name": "$cursor_target",
                "property_bag": {
                  "#size": "$cursor_target_length"
                },
                "factory": {
                  "name": "$cursor_factory_name",
                  "control_name": "chest.ez_dump_cursor_place_empty"
                },
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_property_name": "(#size*1)",
                    "target_property_name": "#collection_length"
                  }
                ],
                "$layer_base": 400
              }
            },
            {
              "hotbar_empty_slots": {
                "type": "stack_panel",
                "layer": 3,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [
                  "100%",
                  "100%"
                ],
                "collection_name": "hotbar_items",
                "property_bag": {
                  "#size": 9
                },
                "factory": {
                  "name": "$cursor_hotbar_factory_name",
                  "control_name": "chest.ez_dump_cursor_place_empty"
                },
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_property_name": "(#size*1)",
                    "target_property_name": "#collection_length"
                  }
                ],
                "ignored": "(not $cursor_also_hotbar)",
                "$cursor_target": "hotbar_items",
                "$layer_base": 300
              }
            },
            {
              "same_slots": {
                "type": "stack_panel",
                "layer": 2,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [
                  "100%",
                  "100%"
                ],
                "collection_name": "$cursor_target",
                "property_bag": {
                  "#size": "$cursor_target_length"
                },
                "factory": {
                  "name": "$cursor_same_factory_name",
                  "control_name": "chest.ez_dump_cursor_place_same"
                },
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_property_name": "(#size*1)",
                    "target_property_name": "#collection_length"
                  }
                ],
                "$layer_base": 200
              }
            },
            {
              "hotbar_same_slots": {
                "type": "stack_panel",
                "layer": 1,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "size": [
                  "100%",
                  "100%"
                ],
                "collection_name": "hotbar_items",
                "property_bag": {
                  "#size": 9
                },
                "factory": {
                  "name": "$cursor_hotbar_same_factory_name",
                  "control_name": "chest.ez_dump_cursor_place_same"
                },
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_property_name": "(#size*1)",
                    "target_property_name": "#collection_length"
                  }
                ],
                "ignored": "(not $cursor_also_hotbar)",
                "$cursor_target": "hotbar_items",
                "$layer_base": 100
              }
            }
          ]
        }
      },
      {
        "stack_panel_1": {
          "type": "stack_panel",
          "layer": 10,
          "size": [
            15,
            15
          ],
          "offset": [
            -7.5,
            0
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": "$ez_length"
          },
          "factory": {
            "name": "ez_dump_button_panel_factory_1",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      },
      {
        "stack_panel_2": {
          "type": "stack_panel",
          "layer": 10,
          "size": [
            15,
            15
          ],
          "offset": [
            7.5,
            0
          ],
          "collection_name": "$item_location",
          "property_bag": {
            "#size": "$ez_length"
          },
          "factory": {
            "name": "ez_dump_button_panel_factory_2",
            "control_name": "$factory_selection"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(#size*1)",
              "target_property_name": "#collection_length"
            }
          ]
        }
      },
      {
        "button@common_buttons.light_glyph_button": {
          "$default_glyph_color": "$light_glyph_hover_color",
          "layer": -1
        }
      }
    ],
    "$ez_length|default": 54,
    "$deposit_cursor|default": false,
    "$cursor_also_hotbar|default": false,
    "$cursor_target|default": "container_items",
    "$cursor_target_length|default": 1,
    "$cursor_hit_size|default": [30, 15],
    "$cursor_factory_name|default": "ez_cur_unused_empty",
    "$cursor_same_factory_name|default": "ez_cur_unused_same",
    "$cursor_hotbar_factory_name|default": "ez_cur_unused_hotbar_empty",
    "$cursor_hotbar_same_factory_name|default": "ez_cur_unused_hotbar_same"
  },
  "ez_dump_factory_inventory": {
    "type": "panel",
    "size": [
      "100%",
      0
    ],
    "controls": [
      {
        "input_panel": {
          "type": "input_panel",
          "visible": false,
          "size": [
            "100%",
            "100%x"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "consume_hover_events": false,
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            }
          ],
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#item_id_aux",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$item_location"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#item_id_aux=-1) and (#collection_index>8))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "inventory_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest@pocket_containers.ez_dump_button_panel": {
            "$item_location": "container_items",
            "$button_content": "pocket_containers.ez_dump_image_from_chest",
            "$factory_selection": "chest.ez_dump_factory",
            "offset": [
              0,
              -27
            ],
            "$ez_length": 54
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_inventory@pocket_containers.ez_dump_button_panel": {
            "$item_location": "combined_hotbar_and_inventory_items",
            "$button_content": "pocket_containers.ez_dump_image_from_inventory",
            "$factory_selection": "pocket_containers.ez_dump_factory_inventory",
            "offset": [
              30,
              -27
            ],
            "$ez_length": 36
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest_filtered@pocket_containers.ez_dump_button_panel": {
            "$item_location": "container_items",
            "$button_content": "pocket_containers.ez_dump_image_from_chest_filtered",
            "$factory_selection": "chest.ez_dump_factory_filtered",
            "offset": [
              "85%-30px",
              -27
            ],
            "$ez_length": 54,
            "$deposit_cursor": true,
            "$cursor_target": "combined_hotbar_and_inventory_items",
            "$cursor_target_length": 36,
            "$cursor_factory_name": "ez_cur_p_player_empty",
            "$cursor_same_factory_name": "ez_cur_p_player_same"
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_inventory_filtered@pocket_containers.ez_dump_button_panel": {
            "$item_location": "combined_hotbar_and_inventory_items",
            "$button_content": "pocket_containers.ez_dump_image_from_inventory_filtered",
            "$factory_selection": "chest.ez_dump_factory_filtered",
            "offset": [
              "85%",
              -27
            ],
            "$ez_length": 36,
            "$deposit_cursor": true,
            "$cursor_target": "container_items",
            "$cursor_target_length": 54,
            "$cursor_factory_name": "ez_cur_p_chest_empty",
            "$cursor_same_factory_name": "ez_cur_p_chest_same"
          }
        }
      }
    ]
  }
}
