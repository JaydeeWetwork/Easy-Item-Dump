// Easy Item Dump
// Original developer: Bud (bud-aj29)
// Successor developers: Jaydee Wetwork & Grok Build
// Desktop data-driven containers. Slot count is the screen variable $container_size.
{
  "namespace": "data_driven_container",
  "desktop_panel/root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest@chest.ez_dump_button_panel": {
            "$item_location": "container_items",
            "$button_content": "chest.ez_dump_image_from_chest",
            "$factory_selection": "chest.ez_dump_factory",
            "$ez_length": "$container_size",
            "offset": [
              -15,
              0
            ]
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_inventory@chest.ez_dump_button_panel": {
            "$item_location": "inventory_items",
            "$button_content": "chest.ez_dump_image_from_inventory",
            "$factory_selection": "chest.ez_dump_factory",
            "$ez_length": 27,
            "offset": [
              -30,
              0
            ]
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_chest_filtered@chest.ez_dump_button_panel": {
            "$item_location": "container_items",
            "$button_content": "chest.ez_dump_image_from_chest_filtered",
            "$factory_selection": "chest.ez_dump_factory_filtered",
            "$ez_length": "$container_size",
            "offset": [
              -15,
              30
            ],
            "$deposit_cursor": true,
            "$cursor_also_hotbar": true,
            "$cursor_target": "inventory_items",
            "$cursor_target_length": 27,
            "$cursor_factory_name": "ez_cur_d_player_empty",
            "$cursor_same_factory_name": "ez_cur_d_player_same",
            "$cursor_hotbar_factory_name": "ez_cur_d_player_hb_empty",
            "$cursor_hotbar_same_factory_name": "ez_cur_d_player_hb_same"
          }
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "from_inventory_filtered@chest.ez_dump_button_panel": {
            "$item_location": "inventory_items",
            "$button_content": "chest.ez_dump_image_from_inventory_filtered",
            "$factory_selection": "chest.ez_dump_factory_filtered",
            "$ez_length": 27,
            "offset": [
              -30,
              30
            ],
            "$include_hotbar": true,
            "$deposit_cursor": true,
            "$cursor_target": "container_items",
            "$cursor_target_length": "$container_size",
            "$cursor_factory_name": "ez_cur_d_box_empty",
            "$cursor_same_factory_name": "ez_cur_d_box_same"
          }
        }
      }
    ]
  }
}
